# Arry Commerce — environment template (never commit real secrets)

# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Stripe (test mode placeholders — replace when A's account is ready)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Stripe Price IDs (create in Dashboard → Products, then paste here)
